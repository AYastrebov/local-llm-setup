#!/bin/bash
# Launch Qwen3.8-27B (dense, vision-language) via llama.cpp.
#
# 27B dense params, hybrid Gated DeltaNet + Gated Attention, native 262K context.
# Platform is auto-detected; override MODEL/CTX/reasoning via the env vars below.
#
#   macOS  M2 Max 64 GB unified : UD-Q6_K_XL  (25.9 GB) + mmproj -> vision enabled
#   Fedora RX 9060 XT 16 GB VRAM: UD-IQ3_XXS  (10.9 GB) + --no-mmproj to protect VRAM
#
# MTP (multi-token prediction) is ON. The main GGUF already carries the NextN/MTP
# block (blk.64.nextn.*), so llama.cpp builds the draft context from the target
# model itself -- no separate -MTP- repo or sidecar download is needed.
# RX 9060 XT, build 11514: 20.6 t/s without MTP -> 41.1 t/s with it (~2.0x).
# The no-MTP figure was 14.8 on build 10884, so the base decode path gained
# ~39% from HIP/CUDA work in between; the MTP path did not move. MTP is still
# a 2x win, just a smaller multiple than the 2.3x first measured.
#
# Usage:
#   qwen              -> start server (default, port 8080)
#   qwen chat         -> interactive CLI, thinking on  (temp 1.0)
#   qwen chat-fast    -> interactive CLI, thinking OFF (temp 0.7, instruct params)
#   qwen server 8001  -> start server on custom port

if [[ "$(uname -s)" == "Darwin" ]]; then
  MODEL="${QWEN_MODEL:-unsloth/Qwen3.8-27B-GGUF:UD-Q6_K_XL}"
  CTX_SIZE="${QWEN_CTX:-65536}"
  # -hf pulls mmproj-BF16.gguf (~0.9 GB) automatically, which enables image input.
  # (It selects BF16, not F16 -- do not fetch F16 by hand, it will sit unused.)
  PLATFORM_FLAGS="--fit-target 4096"
  # 64 GB unified leaves room for the higher-quality KV cache.
  KV_CACHE="--cache-type-k q8_0 --cache-type-v q8_0"
  # Depth 4 is the Metal optimum as measured 2026-09-10 (off 11.3 / n3 19.0 /
  # n4 19.1 / n6 17.2). Fedora's retune to 3 is a ROCm result and is NOT
  # applied here -- the Metal curve is flatter and was measured separately.
  # --spec-draft-sampling is likewise left at llama.cpp's greedy default until
  # someone measures probabilistic on this box; it is an algorithmic change,
  # so it may well help, but that is a guess until it is run.
  MTP_NMAX_DEFAULT=4
  MTP_SAMPLING_DEFAULT=greedy
else
  MODEL="${QWEN_MODEL:-unsloth/Qwen3.8-27B-GGUF:UD-IQ3_XXS}"
  CTX_SIZE="${QWEN_CTX:-65536}"
  # The 0.9 GB mmproj would eat the headroom, so vision is off here.
  # To enable it instead, run: QWEN_CTX=32768 qwen --mmproj-auto
  #
  # --fit-target 2560 keeps ~2.3 GB of the 16 GB free. The desktop (gnome-shell,
  # Xwayland, terminal) alone holds ~1.9 GB; at the default 1024 margin llama fills
  # to 98% and the compositor OOMs the GPU ("amdgpu: Not enough memory for command
  # submission"), which kills the terminal out from under whatever is running.
  PLATFORM_FLAGS="--no-mmproj --fit-target 2560"
  # q4_0 is not just a VRAM saving here: the ROCm/RDNA4 flash-attention kernel has
  # a fast path for it. Measured at fixed 2560 margin, ctx 65536, MTP on:
  #   q4_0/q4_0 34.2 t/s | q5_1/q4_0 18.7 | q8_0/q4_0 16.7 | q8_0/q8_0 13.4
  # Re-checked on build 11514 and still true: q8_0/q8_0 14.4 vs q4_0/q4_0 41.1.
  KV_CACHE="--cache-type-k q4_0 --cache-type-v q4_0"
  # Retuned 2026-10-08 on build 11514. The optimum moved 4 -> 3 because base
  # decode got ~39% faster while the MTP path did not, which changes the
  # speculation economics. Depth sweep (median t/s, probabilistic, n=6):
  #   2->35.8  3->40.9  4->36.7  6->15.0
  # And --spec-draft-sampling (new in #27694; llama.cpp defaults to greedy),
  # n=10 per cell, medians reproducible to <0.2 t/s across reruns:
  #   n4 greedy 35.9 | n4 prob 37.2 | n3 greedy 36.6 | n3 prob 41.1
  # The two compound (+14% together vs +2% / +3.6% alone). Probabilistic makes
  # the drafter sample and the target verify by rejection sampling, which is
  # also the distribution-preserving variant for temp > 0.
  MTP_NMAX_DEFAULT=3
  MTP_SAMPLING_DEFAULT=probabilistic
fi

# Set QWEN_MTP=0 to disable speculative decoding entirely. Depth and draft
# sampling default per platform above; override with QWEN_MTP_NMAX /
# QWEN_MTP_SAMPLING.
MTP_NMAX="${QWEN_MTP_NMAX:-$MTP_NMAX_DEFAULT}"
MTP_SAMPLING="${QWEN_MTP_SAMPLING:-$MTP_SAMPLING_DEFAULT}"
if [[ "${QWEN_MTP:-1}" == "0" ]]; then
  MTP=""
else
  MTP="--spec-type draft-mtp --spec-draft-n-max $MTP_NMAX --spec-draft-sampling $MTP_SAMPLING"
fi

# Per the Qwen3.8 model card (repetition_penalty 1.0 is llama.cpp's default):
#   thinking mode : temp 1.0, top-p 0.95, top-k 20, min-p 0.0, presence-penalty 0.0
#   instruct mode : temp 0.7, top-p 0.80, top-k 20, min-p 0.0, presence-penalty 1.5
SAMPLING_THINK="--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 --presence-penalty 0.0"
SAMPLING_FAST="--temp 0.7 --top-p 0.80 --top-k 20 --min-p 0.0 --presence-penalty 1.5"

# Reasoning depth. The Qwen3.8 chat template accepts only xhigh (its own default),
# medium and low -- passing "none" raises a Jinja exception, so true non-thinking
# comes from llama.cpp's --reasoning off instead (used by chat-fast below).
QWEN_REASONING="${QWEN_REASONING:-medium}"

MODE="${1:-server}"
shift 2>/dev/null

case "$MODE" in
  chat)
    exec llama-cli \
      -hf "$MODEL" \
      --ctx-size "$CTX_SIZE" \
      --conversation \
      --jinja \
      --reasoning-effort "$QWEN_REASONING" \
      --flash-attn on \
      $PLATFORM_FLAGS \
      $KV_CACHE \
      $MTP \
      $SAMPLING_THINK \
      "$@"
    ;;
  chat-fast)
    exec llama-cli \
      -hf "$MODEL" \
      --ctx-size "$CTX_SIZE" \
      --conversation \
      --jinja \
      --reasoning off \
      --flash-attn on \
      $PLATFORM_FLAGS \
      $KV_CACHE \
      $MTP \
      $SAMPLING_FAST \
      "$@"
    ;;
  server)
    PORT="${1:-8080}"
    shift 2>/dev/null
    echo "Starting Qwen3.8-27B (dense, VL) on http://localhost:$PORT"
    echo "  model: $MODEL   ctx: $CTX_SIZE   reasoning: $QWEN_REASONING   mtp: ${MTP:-off}"
    exec llama-server \
      -hf "$MODEL" \
      --ctx-size "$CTX_SIZE" \
      --jinja \
      --reasoning-effort "$QWEN_REASONING" \
      --alias "qwen3.8-27b" \
      --port "$PORT" \
      --flash-attn on \
      --fit on \
      -np 1 \
      $PLATFORM_FLAGS \
      $KV_CACHE \
      $MTP \
      $SAMPLING_THINK \
      "$@"
    ;;
  *)
    echo "Usage: $(basename "$0") [chat|chat-fast|server] [port] [extra llama.cpp flags...]"
    echo ""
    echo "Modes:"
    echo "  server       OpenAI-compatible API + web UI (default, port 8080)"
    echo "  chat         Interactive CLI, thinking on  (temp 1.0)"
    echo "  chat-fast    Interactive CLI, thinking off (temp 0.7, instruct params)"
    echo ""
    echo "Env: QWEN_MODEL (override -hf ref), QWEN_CTX (context size),"
    echo "     QWEN_REASONING=xhigh|medium|low, QWEN_MTP=0 (disable MTP),"
    echo "     QWEN_MTP_NMAX=N (draft depth; default 3 on Linux, 4 on macOS),"
    echo "     QWEN_MTP_SAMPLING=greedy|probabilistic (default: probabilistic on"
    echo "       Linux, greedy on macOS)"
    exit 1
    ;;
esac

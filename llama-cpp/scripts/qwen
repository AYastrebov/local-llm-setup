#!/bin/bash
# Launch Qwen3.8-27B (dense, vision-language) via llama.cpp.
#
# 27B dense params, hybrid Gated DeltaNet + Gated Attention, native 262K context.
# Thinking mode is ON by default and can be toggled per mode below.
# Platform is auto-detected; override MODEL/CTX_SIZE via the env vars below.
#
#   macOS  M2 Max 64 GB unified : UD-Q6_K_XL  (25.9 GB) + mmproj -> vision enabled
#   Fedora RX 9060 XT 16 GB VRAM: UD-IQ3_XXS  (11.9 GB) + --no-mmproj to protect VRAM
#
# NOTE: there is no MTP GGUF published for Qwen3.8-27B, so this launcher carries no
# --spec-type flags on either platform. Re-add them if unsloth publishes an -MTP- repo.
#
# Usage:
#   qwen              -> start server (default, port 8080)
#   qwen chat         -> interactive CLI, thinking on  (temp 1.0)
#   qwen chat-fast    -> interactive CLI, thinking off (temp 0.7, instruct params)
#   qwen server 8001  -> start server on custom port

if [[ "$(uname -s)" == "Darwin" ]]; then
  MODEL="${QWEN_MODEL:-unsloth/Qwen3.8-27B-GGUF:UD-Q6_K_XL}"
  CTX_SIZE="${QWEN_CTX:-65536}"
  # -hf pulls mmproj-F16.gguf (~0.9 GB) automatically, which enables image input.
  PLATFORM_FLAGS=""
else
  MODEL="${QWEN_MODEL:-unsloth/Qwen3.8-27B-GGUF:UD-IQ3_XXS}"
  CTX_SIZE="${QWEN_CTX:-65536}"
  # 11.9 GB weights + ~2.1 GB q8_0 KV at 65536 ctx leaves ~2 GB of the 16 GB VRAM.
  # The 0.9 GB mmproj would eat that, so vision is off here. To enable it instead,
  # run: QWEN_CTX=32768 qwen --mmproj-auto
  PLATFORM_FLAGS="--no-mmproj"
fi

KV_CACHE="--cache-type-k q8_0 --cache-type-v q8_0"

# Per the Qwen3.8 model card:
#   thinking mode : temp 1.0, top-p 0.95, top-k 20, min-p 0.0, presence-penalty 0.0
#   instruct mode : temp 0.7, top-p 0.80, top-k 20, min-p 0.0, presence-penalty 1.5
SAMPLING_THINK="--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 --presence-penalty 0.0"
SAMPLING_FAST="--temp 0.7 --top-p 0.80 --top-k 20 --min-p 0.0 --presence-penalty 1.5"

MODE="${1:-server}"
shift 2>/dev/null

case "$MODE" in
  chat)
    exec llama-cli \
      -hf "$MODEL" \
      --ctx-size "$CTX_SIZE" \
      --conversation \
      --jinja \
      --chat-template-kwargs '{"enable_thinking":true}' \
      --flash-attn on \
      $PLATFORM_FLAGS \
      $KV_CACHE \
      $SAMPLING_THINK \
      "$@"
    ;;
  chat-fast)
    exec llama-cli \
      -hf "$MODEL" \
      --ctx-size "$CTX_SIZE" \
      --conversation \
      --jinja \
      --chat-template-kwargs '{"enable_thinking":false}' \
      --flash-attn on \
      $PLATFORM_FLAGS \
      $KV_CACHE \
      $SAMPLING_FAST \
      "$@"
    ;;
  server)
    PORT="${1:-8080}"
    shift 2>/dev/null
    echo "Starting Qwen3.8-27B (dense, VL) on http://localhost:$PORT"
    echo "  model: $MODEL   ctx: $CTX_SIZE"
    exec llama-server \
      -hf "$MODEL" \
      --ctx-size "$CTX_SIZE" \
      --jinja \
      --chat-template-kwargs '{"enable_thinking":true}' \
      --alias "qwen3.8-27b" \
      --port "$PORT" \
      --flash-attn on \
      --fit on \
      -np 1 \
      $PLATFORM_FLAGS \
      $KV_CACHE \
      $SAMPLING_THINK \
      "$@"
    ;;
  *)
    echo "Usage: $(basename "$0") [chat|chat-fast|server] [port] [extra llama.cpp flags...]"
    echo ""
    echo "Modes:"
    echo "  server       OpenAI-compatible API + web UI (default, port 8080)"
    echo "  chat         Interactive CLI, thinking on  (temp 1.0)"
    echo "  chat-fast    Interactive CLI, thinking off (temp 0.7, instruct params)"
    echo ""
    echo "Env: QWEN_MODEL (override -hf ref), QWEN_CTX (override context size)"
    exit 1
    ;;
esac

#!/bin/bash
# Launch Qwen3.6-27B dense with MTP (Multi-Token Prediction) via llama.cpp
# All 27B params active - higher quality than MoE. MTP gives ~1.4-2.2x speedup.
#
# Platform-specific model (edit MODEL below):
#   macOS M2 Max 64GB : 27B-MTP dense UD-Q6_K_XL (26 GB)
#   Fedora 16GB VRAM  : 35B-A3B-MTP MoE UD-IQ3_XXS (~14 GB)
#
# Usage:
#   qwen-moe              -> start server (default, port 8080)
#   qwen-moe chat         -> interactive CLI (coding, thinking enabled, temp 0.6)
#   qwen-moe chat-think   -> interactive CLI (general/creative, temp 1.0)
#   qwen-moe server 8001  -> start server on custom port

# --- Set model for your platform ---
# macOS (64GB):  27B dense with MTP
MODEL="unsloth/Qwen3.6-27B-MTP-GGUF:UD-Q6_K_XL"
# Fedora (16GB): 35B-A3B MoE with MTP
# MODEL="unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-IQ3_XXS"

CTX_SIZE=65536
KV_CACHE="--cache-type-k q8_0 --cache-type-v q8_0"
MTP="--spec-type draft-mtp --spec-draft-n-max 6"

MODE="${1:-server}"
shift 2>/dev/null

case "$MODE" in
  chat)
    exec llama-cli \
      -hf "$MODEL" \
      --ctx-size "$CTX_SIZE" \
      --conversation \
      --chat-template-kwargs '{"enable_thinking":true}' \
      --flash-attn on \
      $KV_CACHE \
      $MTP \
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0.0 \
      "$@"
    ;;
  chat-think)
    exec llama-cli \
      -hf "$MODEL" \
      --ctx-size "$CTX_SIZE" \
      --conversation \
      --chat-template-kwargs '{"enable_thinking":true}' \
      --flash-attn on \
      $KV_CACHE \
      $MTP \
      --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 \
      --presence-penalty 1.5 \
      "$@"
    ;;
  server)
    PORT="${1:-8080}"
    shift 2>/dev/null
    echo "Starting Qwen3.6-27B (dense, MTP) on http://localhost:$PORT"
    exec llama-server \
      -hf "$MODEL" \
      --ctx-size "$CTX_SIZE" \
      --jinja \
      --chat-template-kwargs '{"enable_thinking":true}' \
      --alias "qwen3.6-27b" \
      --port "$PORT" \
      --flash-attn on \
      --fit on \
      $KV_CACHE \
      $MTP \
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0.0 \
      "$@"
    ;;
  *)
    echo "Usage: $(basename "$0") [chat|chat-think|server] [port] [extra flags...]"
    echo ""
    echo "Modes:"
    echo "  server       OpenAI-compatible API (default, port 8080)"
    echo "  chat         Interactive CLI with thinking (coding params, temp 0.6)"
    echo "  chat-think   Interactive CLI with thinking (general/creative, temp 1.0)"
    exit 1
    ;;
esac

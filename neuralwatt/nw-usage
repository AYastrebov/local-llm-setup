#!/bin/bash
# Neuralwatt API usage - balance, today's requests/tokens/cost/energy, 7- and 30-day totals, runway
#
# Usage:
#   nw-usage                       # Human-readable output (always fresh)
#   nw-usage --tmux                # Compact for tmux/statusline (cached 5min)
#   nw-usage --tmux --color '1;32' # With ANSI color (bright green)
#   nw-usage --json                # Raw JSON (always fresh)

set -euo pipefail

CACHE_FILE="/tmp/nw-usage-cache.json"
CACHE_MAX_AGE=60  # 5 minutes
API_KEY_FILE="${NEURALWATT_API_KEY_FILE:-$HOME/.config/neuralwatt/api_key}"

# Parse args
FORMAT="human"
USE_CACHE=false
COLOR=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --tmux) FORMAT="tmux"; USE_CACHE=true; shift ;;
    --json) FORMAT="json"; shift ;;
    --color)
      COLOR="${2:-}"
      shift 2
      ;;
    --help|-h)
      echo "Usage: nw-usage [--tmux|--json] [--color CODE]"
      echo "  --tmux        Compact output for statusline (cached)"
      echo "  --json        Raw JSON from API"
      echo "  --color CODE  ANSI color code (e.g., '1;32' for bright green)"
      exit 0
      ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

# Check cache freshness (only for --tmux)
use_cache=false
if [[ "$USE_CACHE" == "true" ]] && [[ -f "$CACHE_FILE" ]]; then
  if [[ "$(uname)" == "Darwin" ]]; then
    cache_mtime=$(stat -f %m "$CACHE_FILE")
  else
    cache_mtime=$(stat -c %Y "$CACHE_FILE")
  fi
  cache_age=$(($(date +%s) - cache_mtime))
  if [[ $cache_age -lt $CACHE_MAX_AGE ]]; then
    use_cache=true
  fi
fi

# Get data (from cache or API)
if [[ "$use_cache" == "true" ]]; then
  data=$(cat "$CACHE_FILE")
else
  # Get API key (env var → libsecret keyring → file)
  api_key=""
  if [[ -n "${NEURALWATT_API_KEY:-}" ]]; then
    api_key="$NEURALWATT_API_KEY"
  elif command -v secret-tool >/dev/null 2>&1; then
    api_key=$(secret-tool lookup service neuralwatt user "$USER" 2>/dev/null || true)
  fi
  if [[ -z "$api_key" ]] && [[ -f "$API_KEY_FILE" ]]; then
    api_key=$(cat "$API_KEY_FILE")
  fi
  if [[ -z "$api_key" ]]; then
    echo "Error: No API key found. Set NEURALWATT_API_KEY, store via 'secret-tool store service neuralwatt user \$USER', or create $API_KEY_FILE" >&2
    exit 1
  fi

  fetch() { curl -s --max-time 10 -H "Authorization: Bearer $api_key" "https://api.neuralwatt.com/v1/$1" 2>/dev/null; }
  energy=$(fetch usage/energy); summary=$(fetch usage/summary); balance=$(fetch billing/balance)
  data=$(jq -n --argjson e "${energy:-null}" --argjson s "${summary:-null}" --argjson b "${balance:-null}" \
    '{energy: $e, summary: $s, balance: $b}' 2>/dev/null || true)

  if [[ -z "$data" ]] || ! echo "$data" | jq -e '.energy.totals and .summary.totals' >/dev/null 2>&1; then
    echo "Error: Failed to fetch usage data" >&2
    exit 1
  fi

  echo "$data" > "$CACHE_FILE"
fi

# Format output
# Shared jq helpers: today's/7-day figures by date (API dates are UTC), balance and runway.
JQ_DEFS='
  def today: (now | strftime("%Y-%m-%d"));
  def since(n): ((now - n*86400) | strftime("%Y-%m-%d"));
  def sum_s(from): [.summary.time_series[] | select(.date >= from)] | {req: (map(.requests)|add // 0), tok: (map(.total_tokens)|add // 0), cost: (map(.cost_usd)|add // 0)};
  def sum_e(from): [.energy.daily[] | select(.date >= from)] | {wh: ((map(.energy_kwh)|add // 0) * 1000), co2: (map(.carbon_g_co2eq // 0)|add // 0)};
  def usd: if . < 0.01 and . > 0 then (. * 10000 | round / 10000 | tostring) else (. * 100 | round / 100 | tostring) end | "$" + .;
  def tok: if . >= 1e6 then ((. / 1e5 | round) / 10 | tostring) + "M" elif . >= 1e3 then ((. / 1e3 | round) | tostring) + "K" else tostring end;
  def bal: (.balance.dollar_balance // null);
'
case "$FORMAT" in
  json)
    echo "$data"
    ;;
  tmux)
    output=$(jq -r "$JQ_DEFS"'
      sum_s(today) as $t | sum_e(today) as $e
      | [ (bal | if . == null then empty else usd end), "↗\($t.req)", "⚡\($e.wh | round)Wh" ] | join(" ")' <<< "$data")
    if [[ -n "$COLOR" ]]; then
      printf "\033[%sm%s\033[0m\n" "$COLOR" "$output"
    else
      echo "$output"
    fi
    ;;
  human)
    jq -r "$JQ_DEFS"'
      sum_s(today) as $t | sum_e(today) as $te | sum_s(since(6)) as $w | sum_e(since(6)) as $we
      | .summary.totals as $m | .energy.totals as $me
      | ($w.cost / 7) as $per_day
      | "Neuralwatt usage (UTC \(today))",
        "  Balance:  \(bal | if . == null then "n/a" else usd end)" + (if $per_day > 0 and bal != null then "  (~\(bal / $per_day | floor) days at \($per_day | usd)/day, 7-day avg)" else "" end),
        "  Today:    \($t.req) req, \($t.tok | tok) tokens, \($t.cost | usd), \($te.wh | round)Wh, \($te.co2 * 10 | round / 10)g CO2",
        "  7 days:   \($w.req) req, \($w.tok | tok) tokens, \($w.cost | usd), \($we.wh | round)Wh",
        "  30 days:  \($m.requests) req, \($m.total_tokens | tok) tokens, \($m.total_cost_usd | usd), \($me.energy_kwh * 1000 | round)Wh, \(($me.carbon_g_co2eq // 0) | round)g CO2",
        "  Cache:    \(if $m.total_tokens > 0 then (($m.cached_tokens // 0) / $m.total_tokens * 100 | round) else 0 end)% of 30-day tokens were prompt-cache hits"' <<< "$data"
    ;;
esac

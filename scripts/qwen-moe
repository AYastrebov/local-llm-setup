#!/bin/bash
# Launch Qwen3.6-35B-A3B (MoE, 3B active) via llama.cpp
# Supports thinking mode.
#
# Platform-specific quant (edit MODEL below):
#   macOS M2 Max 64GB : UD-Q4_K_XL (~18 GB) — more headroom, higher quality
#   Fedora 16GB VRAM  : UD-IQ3_XXS (~13 GB) — KV cache quant required
#
# Usage:
#   qwen-moe              → start server (default, port 8080)
#   qwen-moe chat         → interactive CLI (coding, thinking enabled, temp 0.6)
#   qwen-moe chat-think   → interactive CLI (general/creative, temp 1.0)
#   qwen-moe server 8001  → start server on custom port

# --- Set quant for your platform ---
# macOS (64GB):  UD-Q4_K_XL
# Fedora (16GB): UD-IQ3_XXS
MODEL="unsloth/Qwen3.6-35B-A3B-GGUF:UD-IQ3_XXS"
# MODEL="unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q4_K_XL"   # macOS 64GB
CTX_SIZE=65536
KV_CACHE="--cache-type-k q8_0 --cache-type-v q8_0"

MODE="${1:-server}"
shift 2>/dev/null

case "$MODE" in
  chat)
    exec llama-cli \
      -hf "$MODEL" \
      --ctx-size "$CTX_SIZE" \
      --conversation \
      --chat-template-kwargs '{"enable_thinking":true}' \
      --flash-attn on \
      $KV_CACHE \
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0.0 \
      "$@"
    ;;
  chat-think)
    exec llama-cli \
      -hf "$MODEL" \
      --ctx-size "$CTX_SIZE" \
      --conversation \
      --chat-template-kwargs '{"enable_thinking":true}' \
      --flash-attn on \
      $KV_CACHE \
      --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 \
      --presence-penalty 1.5 \
      "$@"
    ;;
  server)
    PORT="${1:-8080}"
    shift 2>/dev/null
    echo "Starting Qwen3.6-35B-A3B MoE on http://localhost:$PORT"
    exec llama-server \
      -hf "$MODEL" \
      --ctx-size "$CTX_SIZE" \
      --jinja \
      --chat-template-kwargs '{"enable_thinking":true}' \
      --alias "qwen3.6-35b-a3b" \
      --port "$PORT" \
      --flash-attn on \
      --fit on \
      $KV_CACHE \
      --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0.0 \
      "$@"
    ;;
  *)
    echo "Usage: $(basename "$0") [chat|chat-think|server] [port] [extra flags...]"
    echo ""
    echo "Modes:"
    echo "  server       OpenAI-compatible API (default, port 8080)"
    echo "  chat         Interactive CLI with thinking (coding params, temp 0.6)"
    echo "  chat-think   Interactive CLI with thinking (general/creative, temp 1.0)"
    exit 1
    ;;
esac

{
  "$schema": "https://opencode.ai/config.json",

  // ==========================================
  // ⚙️ GLOBAL SETTINGS
  // ==========================================
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },

  // ==========================================
  // 🔬 LSP
  // ==========================================
  "lsp": {
    "gopls": {
      "command": ["gopls"]
    },
    "typescript": {
      "command": ["typescript-language-server", "--stdio"]
    },
    "rust": {
      "command": ["rust-analyzer"]
    },
    "vue": {
      "command": ["vue-language-server", "--stdio"]
    },
    "kotlin": {
      "command": ["kotlin-lsp", "--stdio"],
      "extensions": [".kt", ".kts"]
    }
  },

  // ==========================================
  // 🧠 PROVIDERS & MODELS
  // ==========================================
  "provider": {
    "neuralwatt": {
      "name": "Neuralwatt",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.neuralwatt.com/v1",
        "apiKey": "{env:NEURALWATT_API_KEY}"
      },
      "models": {
        "zai-org/GLM-5.1-FP8": {
          "name": "GLM 5.1 FP8",
          "limit": { "context": 202736, "output": 202736 }
        },
        "Qwen/Qwen3.6-35B-A3B": {
          "name": "Qwen3.6 35B A3B",
          "limit": { "context": 131056, "output": 131056 }
        },
        "qwen3.6-35b-fast": {
          "name": "Qwen3.6 35B Fast (no reasoning)",
          "limit": { "context": 131056, "output": 131056 }
        },
        "mistralai/Devstral-Small-2-24B-Instruct-2512": {
          "name": "Devstral Small 2 24B",
          "limit": { "context": 262128, "output": 262128 },
          "options": {
            "temperature": 0.3,
            "maxTokens": 4096
          }
        }
      }
    },
    "mimo": {
      "name": "Xiaomi MiMo",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.xiaomimimo.com/v1",
        "apiKey": "{env:MIMO_API_KEY}"
      },
      "models": {
        "mimo-v2.5": {
          "name": "MiMo V2.5 (Omni)",
          "limit": { "context": 1048576, "output": 131072 }
        },
        "mimo-v2.5-pro": {
          "name": "MiMo V2.5 Pro",
          "limit": { "context": 1048576, "output": 131072 }
        }
      }
    },
    "moonshot": {
      "name": "Moonshot",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.moonshot.cn/v1",
        "apiKey": "{env:MOONSHOT_API_KEY}"
      },
      "models": {
        "kimi-k2.6": {
          "name": "Kimi K2.6",
          "limit": { "context": 262128, "output": 32768 }
        }
      }
    },
    "deepseek": {
      "name": "DeepSeek",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "limit": { "context": 1048576, "output": 131072 }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "limit": { "context": 1048576, "output": 131072 }
        }
      }
    },
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "gemma-4-26b-a4b": {
          "name": "Gemma 4 26B-A4B MoE (Local)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B MoE (Local)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },

  // ==========================================
  // 💡 COMMANDS
  // ==========================================
  "command": {
    "nw-usage": {
      "description": "Show Neuralwatt energy usage",
      "template": "Here is my Neuralwatt API usage:\n\n!`nw-usage`\n\nReport this to the user."
    },
    "jb-usage": {
      "description": "Show JetBrains Central quota usage",
      "template": "Here is my JetBrains Central quota:\n\n!`jb-usage`\n\nReport this to the user."
    }
  },

  // ==========================================
  // 🔌 MODEL CONTEXT PROTOCOL (MCP) SERVERS
  // ==========================================
  "mcp": {
    "jetbrains": {
      "type": "remote",
      "url": "http://127.0.0.1:64342/sse",
      "enabled": false
    },
    "youtrack": {
      "type": "remote",
      "url": "https://youtrack.jetbrains.com/mcp",
      "headers": { "Authorization": "Bearer {env:YOUTRACK_TOKEN}" },
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}" },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" }
    }
  },

  // ==========================================
  // 🛡️ SECURITY & PERMISSIONS
  // ==========================================
  "permission": {
    "read": "allow",
    "write": "ask", // Global write requires approval
    "apply_patch": "ask", // Treat bulk file patches like writes
    "websearch": "deny", // Requires OPENCODE_ENABLE_EXA=1 — explicitly off
    "jetbrains_*": "allow",
    "youtrack_*": "allow",
    "bash": {
      "./gradlew*": "allow",
      "git *": "allow",
      // Modern read-only CLI tools — faster, sensible defaults
      "rg *": "allow",     // ripgrep (grep replacement)
      "fd *": "allow",     // fd (find replacement)
      "bat *": "allow",    // bat (cat replacement, syntax-highlighted)
      "eza *": "allow",    // eza (ls replacement)
      "jq *": "allow",     // JSON query/filter
      // Prompt for any potentially destructive commands
      "*": "ask"
    }
  },

  // ==========================================
  // 🤖 AGENT PROFILES
  // ==========================================
  "agent": {
    // --- Built-in opencode modes (plan / build) ---
    "plan": {
      "description": "Planning mode — read-only analysis, architecture decisions, and step-by-step plans before execution",
      "model": "deepseek/deepseek-v4-pro",
      "steps": 30
    },
    "build": {
      "description": "Default execution mode — DeepSeek V4 Flash for fast, cheap implementation. Pair with /plan first for best results",
      "model": "deepseek/deepseek-v4-flash",
      "steps": 100
    },

    "local-gemma": {
      "description": "Local Gemma 4 26B-A4B MoE for reasoning with thinking. Runs offline on RX 9060 XT at Q3_K_XL. Start with: gemma-moe",
      "mode": "subagent",
      "model": "local/gemma-4-26b-a4b",
      "temperature": 1.0,
      "steps": 15,
      "permission": {
        "edit": "allow",
        "write": "allow",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },
    "local-moe": {
      "description": "Local Qwen3.6-35B-A3B for general reasoning with thinking. Runs offline on RX 9060 XT at IQ3_XXS. Start with: qwen-mtp",
      "mode": "subagent",
      "model": "local/qwen3.6-35b-a3b",
      "temperature": 0.6,
      "steps": 15,
      "permission": {
        "edit": "allow",
        "write": "allow",
        "webfetch": "deny",
        "websearch": "deny"
      }
    },

    // --- Xiaomi MiMo cloud models ---
    "mimo": {
      "description": "MiMo V2.5 Omni via Xiaomi — thinking + tool use, 1M context, multimodal",
      "mode": "primary",
      "model": "mimo/mimo-v2.5",
      "steps": 50
    },
    "mimo-pro": {
      "description": "MiMo V2.5 Pro via Xiaomi — full reasoning + tool use, 1M context",
      "mode": "primary",
      "model": "mimo/mimo-v2.5-pro",
      "steps": 100
    },

    // --- Moonshot cloud models ---
    "kimi": {
      "description": "Kimi K2.6 via Moonshot API — reasoning + tool use, 262K context",
      "mode": "primary",
      "model": "moonshot/kimi-k2.6",
      "steps": 100
    },

    // --- NeuralWatt cloud models ---
    "glm": {
      "description": "GLM 5.1 FP8 via NeuralWatt — reasoning + tool use, 202K context",
      "mode": "primary",
      "model": "neuralwatt/zai-org/GLM-5.1-FP8",
      "steps": 50
    },

    // --- Subagents (delegatable) ---
    "github": {
      "description": "GitHub workflow subagent — DeepSeek V4 Flash. Delegate any GitHub task: PR creation, review fetching/posting, issue triage, branch management, repo/code search, releases, commits. Has the github MCP plus superpowers skills for requesting-code-review, receiving-code-review, and finishing-a-development-branch.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "steps": 30
    },
    "explore": {
      "description": "Fast codebase search subagent — Qwen3.6 35B Fast (no reasoning overhead). For grep, file finding, symbol lookup, and shallow code exploration",
      "mode": "subagent",
      "model": "neuralwatt/qwen3.6-35b-fast",
      "steps": 20
    },
    "docs": {
      "description": "Internal docs subagent — Qwen3.6 35B Fast. For reading project READMEs, code comments, and docstrings. Use Context7 MCP for library/framework documentation instead",
      "mode": "subagent",
      "model": "neuralwatt/qwen3.6-35b-fast",
      "steps": 20
    }
  }
}

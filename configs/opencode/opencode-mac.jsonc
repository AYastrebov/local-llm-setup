{
  "$schema": "https://opencode.ai/config.json",

  // ==========================================
  // ⚙️ GLOBAL SETTINGS
  // ==========================================
  "small_model": "neuralwatt/qwen3.6-35b-fast",
  "plugin": ["octto"],
  "snapshot": false,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8000
  },

  // ==========================================
  // 🧠 PROVIDERS & MODELS
  // ==========================================
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama.cpp",
      "options": { "baseURL": "http://127.0.0.1:8080/v1" },
      "models": {
        "gemma-4-26b-a4b": {
          "name": "Gemma 4 26B-A4B MoE (Local)",
          "limit": { "context": 65536, "output": 8192 }
        },
        "qwen3.6-27b": {
          "name": "Qwen3.6 27B Dense MTP (Local)",
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    },
    "neuralwatt": {
      "name": "Neuralwatt",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.neuralwatt.com/v1",
        "apiKey": "{env:NEURALWATT_API_KEY}"
      },
      "models": {
        "moonshotai/Kimi-K2.6": {
          "name": "Kimi K2.6",
          "limit": { "context": 262128, "output": 262128 },
          "options": { "repetitionPenalty": 1.05 }
        },
        "zai-org/GLM-5.1-FP8": {
          "name": "GLM 5.1 FP8",
          "limit": { "context": 202736, "output": 202736 }
        },
        "Qwen/Qwen3.6-35B-A3B": {
          "name": "Qwen3.6 35B A3B",
          "limit": { "context": 131056, "output": 131056 }
        },
        "qwen3.6-35b-fast": {
          "name": "Qwen3.6 35B Fast (no reasoning)",
          "limit": { "context": 131056, "output": 131056 }
        },
        "mistralai/Devstral-Small-2-24B-Instruct-2512": {
          "name": "Devstral Small 2 24B",
          "limit": { "context": 262128, "output": 262128 },
          "options": { "temperature": 0.3, "maxTokens": 4096 }
        }
      }
    }
  },

  // ==========================================
  // 🔌 MODEL CONTEXT PROTOCOL (MCP) SERVERS
  // ==========================================
  "mcp": {
    "jetbrains": {
      "type": "remote",
      "url": "http://127.0.0.1:64342/sse",
      "enabled": false
    },
    "youtrack": {
      "type": "remote",
      "url": "https://youtrack.jetbrains.com/mcp",
      "headers": { "Authorization": "Bearer {env:YOUTRACK_TOKEN}" },
      "enabled": false
    },
    "glean_default": {
      "type": "remote",
      "url": "https://jetbrains-be.glean.com/mcp/default",
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}" },
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    }
  },

  // ==========================================
  // 🛡️ SECURITY & PERMISSIONS
  // ==========================================
  "permission": {
    "read": "allow",
    "write": "ask", // Global write requires approval
    "apply_patch": "ask", // Treat bulk file patches like writes
    "websearch": "deny", // Requires OPENCODE_ENABLE_EXA=1 — explicitly off
    "jetbrains_*": "allow",
    "youtrack_*": "allow",
    "bash": {
      "./gradlew*": "allow",
      "git *": "allow",
      // Modern read-only CLI tools — faster, sensible defaults
      "rg *": "allow",     // ripgrep (grep replacement)
      "fd *": "allow",     // fd (find replacement)
      "bat *": "allow",    // bat (cat replacement, syntax-highlighted)
      "eza *": "allow",    // eza (ls replacement)
      "jq *": "allow",     // JSON query/filter
      // Prompt for any potentially destructive commands
      "*": "ask"
    }
  },

  // ==========================================
  // 🤖 AGENT PROFILES
  // ==========================================
  "agent": {
    // --- Built-in opencode modes (plan / build) ---
    "plan": {
      "description": "Planning mode — uses GLM 5.1 FP8 for read-only analysis, architecture decisions, and step-by-step plans before execution",
      "model": "neuralwatt/zai-org/GLM-5.1-FP8",
      "steps": 30
    },
    "build": {
      "description": "Default execution mode — uses Devstral Small 2 for cheap, coding-specialized implementation. Pair with /plan first for best results",
      "model": "neuralwatt/mistralai/Devstral-Small-2-24B-Instruct-2512",
      "steps": 100
    },

    // --- Local offline models ---
    "local-moe": {
      "description": "Local Qwen3.6-27B dense with MTP. All 27B params active. Runs offline on M2 Max. Start with: qwen-mtp",
      "mode": "primary",
      "model": "local/qwen3.6-27b",
      "temperature": 0.6,
      "steps": 15,
      "permission": { "edit": "allow", "write": "allow", "webfetch": "deny", "websearch": "deny" }
    },
    "local-gemma": {
      "description": "Local Gemma 4 26B-A4B MoE for reasoning with thinking. Runs offline on M2 Max at Q8 quality. Start with: gemma-moe",
      "mode": "primary",
      "model": "local/gemma-4-26b-a4b",
      "temperature": 1.0,
      "steps": 15,
      "permission": { "edit": "allow", "write": "allow", "webfetch": "deny", "websearch": "deny" }
    },

    // --- NeuralWatt cloud models ---
    "kimi": {
      "description": "Kimi K2.6 via NeuralWatt — reasoning + tool use, 262K context",
      "mode": "primary",
      "model": "neuralwatt/moonshotai/Kimi-K2.6",
      "steps": 100
    },
    "glm": {
      "description": "GLM 5.1 FP8 via NeuralWatt — reasoning + tool use, 202K context",
      "mode": "primary",
      "model": "neuralwatt/zai-org/GLM-5.1-FP8",
      "steps": 50
    },
    "qwen-fast": {
      "description": "Qwen3.6 35B A3B MoE via NeuralWatt — cheap fast tasks, $0.29/M in. Use for summaries, simple edits, quick Q&A",
      "mode": "primary",
      "model": "neuralwatt/Qwen/Qwen3.6-35B-A3B",
      "steps": 15
    },

    // --- Subagents (delegatable) ---
    "explore": {
      "description": "Fast codebase search subagent — Qwen3.6 35B Fast (no reasoning overhead). For grep, file finding, symbol lookup, and shallow code exploration",
      "mode": "subagent",
      "model": "neuralwatt/qwen3.6-35b-fast",
      "steps": 20
    },
    "docs": {
      "description": "Internal docs subagent — Qwen3.6 35B Fast. For reading project READMEs, code comments, and docstrings. Use Context7 MCP for library/framework documentation instead",
      "mode": "subagent",
      "model": "neuralwatt/qwen3.6-35b-fast",
      "steps": 20
    }
  },

  // ==========================================
  // 💬 COMMANDS
  // ==========================================
  "command": {
    "nw-usage": {
      "description": "Show Neuralwatt energy usage",
      "template": "Here is my Neuralwatt API usage:\n\n!`nw-usage`\n\nReport this to the user."
    }
  }
}
